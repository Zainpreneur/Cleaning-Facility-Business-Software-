PORT=4000
NODE_ENV=development

# SQLite by default (zero setup). For Postgres in production use e.g.:
# DATABASE_URL="postgresql://user:password@localhost:5432/cfbs?schema=public"
DATABASE_URL="file:./dev.db"

JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

CORS_ORIGIN="http://localhost:5173"
